# Local image naming. Compose still builds these images from source by default.
F1_DASH_IMAGE_REGISTRY=ghcr.io/your-github-user
F1_DASH_IMAGE_TAG=dev

# Optional recording controls.
RECORDING_ENABLED=true
RECORDING_GZIP=true
# Leave empty to retain completed source recordings indefinitely.
RECORDING_RETENTION_DAYS=

# Required only with compose.production.yaml.
F1_DASH_DOMAIN=f1.example.com
# Recommended for Caddy ACME expiry notices.
CADDY_EMAIL=you@example.com
